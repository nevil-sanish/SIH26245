{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "es2022"], "allowJs": true, "strict": true, "noEmit": true,
    "module": "esnext", "moduleResolution": "bundler", "jsx": "react-jsx", "esModuleInterop": true,
    "resolveJsonModule": true, "isolatedModules": true, "skipLibCheck": true, "incremental": true,
    "plugins": [{ "name": "next" }], "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
